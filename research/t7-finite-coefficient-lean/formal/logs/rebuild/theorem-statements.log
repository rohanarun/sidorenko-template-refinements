T7Gap.tilted_normalized {n : Nat} (d : T7Gap.Bits n) (bias : Rat) (hd : ¬T7Gap.IsZero d) :
  (T7Gap.tiltedExpectation d bias fun x => 1) = 1
T7Gap.tilted_product {n : Nat} (d a b : T7Gap.Bits n) (bias : Rat) :
  (T7Gap.tiltedExpectation d bias fun s => T7Gap.char a s * T7Gap.char b s) =
    (if T7Gap.IsZero (T7Gap.xorBits a b) then 1 else 0) + bias * if T7Gap.BitsEq (T7Gap.xorBits a b) d then 1 else 0
T7Gap.branch_bias_bounds (c : T7.Corner) (b : Bool) : -1 ≤ T7Gap.branchBias c b ∧ T7Gap.branchBias c b ≤ 1
T7Gap.D_nonzero (c : T7.Corner) : ¬T7Gap.IsZero (T7.D c)
T7Gap.activationWeight_nonnegative (c : T7.Corner) (o : T7Gap.ActivationOutcome) : 0 ≤ T7Gap.activationWeight c o
T7Gap.activationExpectation_split (c : T7.Corner) (f : T7Gap.ActivationOutcome → Rat) :
  T7Gap.activationExpectation c f =
    (1 / 2 * T7Gap.tiltedExpectation (T7.D c) (↑(T7.sigma c) / 2) fun s => f (true, s)) +
      1 / 2 * T7Gap.tiltedExpectation (T7.D c) (-↑(T7.sigma c) / 2) fun s => f (false, s)
T7Gap.activation_normalized (c : T7.Corner) : (List.map (T7Gap.activationWeight c) T7Gap.activationOutcomes).sum = 1
T7Gap.union_subset_iff (a b s : T7.Mask) : T7.SubsetMask (T7.unionMask a b) s ↔ T7.SubsetMask a s ∧ T7.SubsetMask b s
T7Gap.tilted_phi_product (c : T7.Corner) (a b : T7.Mask) (branch : Bool) :
  (T7Gap.tiltedExpectation (T7.D c) (T7Gap.branchBias c branch) fun s =>
      T7Gap.phi c a (branch, s) * T7Gap.phi c b (branch, s)) =
    if T7.SubsetMask (T7.unionMask a b) (T7Gap.activationSupport c branch) then
      (if T7.maskEq (T7.diffMask a b) T7.emptyMask then 1 else 0) +
        T7Gap.branchBias c branch * if T7.maskEq (T7.diffMask a b) (T7.D c) then 1 else 0
    else 0
T7Gap.activation_moment_eq_formula (c : T7.Corner) (a b : T7.Mask) : T7Gap.activationMoment c a b = T7.moment c a b
T7Gap.char_agree {n : Nat} (support d s t : T7Gap.Bits n) (hd : T7Gap.SubsetBits d support)
  (ha : T7Gap.AgreeOn support s t) : T7Gap.char d s = T7Gap.char d t
T7Gap.agreement_cons {n : Nat} (support : T7Gap.Bits (n + 1)) (s : T7Gap.Bits n) (t : T7Gap.Bits (n + 1)) (b : Bool) :
  T7Gap.AgreeOn support (fun i => Fin.cases b s i) t ↔
    (support 0 = true → b = t 0) ∧ T7Gap.AgreeOn (fun i => support i.succ) s fun i => t i.succ
T7Gap.cubeSum_agreement (n : Nat) (support t : T7Gap.Bits n) :
  (T7Gap.cubeSum n fun s => if T7Gap.AgreeOn support s t then 1 else 0) = 2 ^ n * (1 / 2) ^ T7Gap.bitCount support
T7Gap.cubeAvg_agreement {n : Nat} (support t : T7Gap.Bits n) :
  (T7Gap.cubeAvg n fun s => if T7Gap.AgreeOn support s t then 1 else 0) = (1 / 2) ^ T7Gap.bitCount support
T7Gap.tilted_marginal {n : Nat} (support d t : T7Gap.Bits n) (bias : Rat) (hd : T7Gap.SubsetBits d support) :
  (T7Gap.tiltedExpectation d bias fun s => if T7Gap.AgreeOn support s t then 1 else 0) =
    (1 / 2) ^ T7Gap.bitCount support * (1 + bias * T7Gap.char d t)
T7Gap.active_support_counts (c : T7.Corner) : T7Gap.bitCount (T7.M c) = 7 ∧ T7Gap.bitCount (T7.D c) = 6
T7Gap.activation_M_sign_marginal (c : T7.Corner) (t : T7Gap.Bits 30) :
  (T7Gap.activationExpectation c fun o => if o.fst = true ∧ T7Gap.AgreeOn (T7.M c) o.snd t then 1 else 0) =
    1 / 2 * (1 / 2) ^ 7 * (1 + ↑(T7.sigma c) / 2 * T7Gap.char (T7.D c) t)
T7Gap.activation_D_sign_marginal (c : T7.Corner) (t : T7Gap.Bits 30) :
  (T7Gap.activationExpectation c fun o => if o.fst = false ∧ T7Gap.AgreeOn (T7.D c) o.snd t then 1 else 0) =
    1 / 2 * (1 / 2) ^ 6 * (1 - ↑(T7.sigma c) / 2 * T7Gap.char (T7.D c) t)
T7Gap.stochastic_identity_eq_fullCoefficient : T7Gap.stochasticCoefficient id = T7.fullCoefficient
T7Gap.stochastic_reversal_eq_fullCoefficient : T7Gap.stochasticCoefficient T7.reverseCorner = T7.reverseFullCoefficient
T7Gap.stochastic_identity_coefficient : T7Gap.stochasticCoefficient id = -(1 / 4 ^ 30)
T7Gap.stochastic_reversal_coefficient : T7Gap.stochasticCoefficient T7.reverseCorner = -(1 / 4 ^ 30)
T7Gap.stochastic_signed_orbit :
  T7Gap.stochasticCoefficient id + T7Gap.stochasticCoefficient T7.reverseCorner = -(1 / 2 ^ 59)
T7Gap.activation_law_exists (c : T7.Corner) :
  ∃ law,
    law.outcomes = T7Gap.activationOutcomes ∧
      law.weight = T7Gap.activationWeight c ∧
        ∀ (a b : T7.Mask), (law.mean fun o => T7Gap.phi c a o * T7Gap.phi c b o) = T7.moment c a b
T7Gap.FiniteLaw.mean_const {α : Type} (law : T7Gap.FiniteLaw α) (r : Rat) : (law.mean fun x => r) = r
T7Gap.FiniteLaw.mean_add {α : Type} (law : T7Gap.FiniteLaw α) (f g : α → Rat) :
  (law.mean fun s => f s + g s) = law.mean f + law.mean g
T7Gap.FiniteLaw.mean_mul {α : Type} (law : T7Gap.FiniteLaw α) (r : Rat) (f : α → Rat) :
  (law.mean fun s => r * f s) = r * law.mean f
T7Gap.FiniteLaw.mean_nonneg {α : Type} (law : T7Gap.FiniteLaw α) (f : α → Rat)
  (hf : ∀ (s : α), s ∈ law.outcomes → 0 ≤ f s) : 0 ≤ law.mean f
T7Gap.FiniteLaw.mean_sum.{u_1} {α : Type} {β : Type u_1} (law : T7Gap.FiniteLaw α) (xs : List β) (f : β → α → Rat) :
  (law.mean fun s => (List.map (fun i => f i s) xs).sum) = (List.map (fun i => law.mean (f i)) xs).sum
T7Gap.FiniteLaw.mean_comm {α β : Type} (left : T7Gap.FiniteLaw α) (right : T7Gap.FiniteLaw β) (f : α → β → Rat) :
  (left.mean fun x => right.mean (f x)) = right.mean fun y => left.mean fun x => f x y
T7Gap.rat_sum_flatMap.{u_1} {α : Type u_1} (xs : List α) (f : α → List Rat) :
  (List.flatMap f xs).sum = (List.map (fun x => (f x).sum) xs).sum
T7Gap.independentMean_succ {α : Type} {n : Nat} (law : T7Gap.FiniteLaw α) (f : (Fin (n + 1) → α) → Rat) :
  T7Gap.independentMean law (n + 1) f =
    law.mean fun x => T7Gap.independentMean law n fun s => f fun i => Fin.cases x s i
T7Gap.independentMean_const {α : Type} (law : T7Gap.FiniteLaw α) (n : Nat) (r : Rat) :
  (T7Gap.independentMean law n fun x => r) = r
T7Gap.productWeight_nonnegative {α : Type} {n : Nat} (law : T7Gap.FiniteLaw α) (s : Fin n → α)
  (hs : ∀ (i : Fin n), s i ∈ law.outcomes) : 0 ≤ T7Gap.productWeight law s
T7Gap.coordinateProduct_one (n : Nat) : (T7Gap.coordinateProduct fun x => 1) = 1
T7Gap.coordinateProduct_nonneg {n : Nat} (f : Fin n → Rat) (h : ∀ (i : Fin n), 0 ≤ f i) : 0 ≤ T7Gap.coordinateProduct f
T7Gap.independent_product {α : Type} (law : T7Gap.FiniteLaw α) (n : Nat) (f : Fin n → α → Rat) :
  ((T7Gap.independentLaw law n).mean fun s => T7Gap.coordinateProduct fun i => f i (s i)) =
    T7Gap.coordinateProduct fun i => law.mean (f i)
T7Gap.independent_bipartite_product {X Y : Type} (left : T7Gap.FiniteLaw X) (right : T7Gap.FiniteLaw Y) (n : Nat)
  (f : Fin n → X → Y → Rat) :
  ((T7Gap.independentLaw left n).mean fun x =>
      (T7Gap.independentLaw right n).mean fun y => T7Gap.coordinateProduct fun i => f i (x i) (y i)) =
    T7Gap.coordinateProduct fun i => left.mean fun x => right.mean (f i x)
T7Gap.activationKernel_nonnegative {X Y : Type} (base : T7Gap.SignedBase X Y) (c : T7.Corner) (x : Fin 30 → X)
  (y : Fin 30 → Y) : 0 ≤ T7Gap.activationKernel base c x y
T7Gap.activationKernel_mean_one {X Y : Type} (base : T7Gap.SignedBase X Y) (c : T7.Corner) :
  ((T7Gap.independentLaw base.left 30).mean fun x =>
      (T7Gap.independentLaw base.right 30).mean (T7Gap.activationKernel base c x)) =
    1
T7Gap.incidentActivationKernel_mean {X Y : Type} (base : T7Gap.SignedBase X Y) (c : T7.Corner) :
  (T7Gap.incidentActivationKernel base c).mean = 1
T7Gap.kernel_construction_has_instance (c : T7.Corner) :
  (T7Gap.incidentActivationKernel T7Gap.unitSignedBase c).mean = 1
T7Gap.pair_sum {X Y : Type} (left : T7Gap.FiniteLaw X) (right : T7Gap.FiniteLaw Y) (f : X × Y → Rat) :
  (List.map (fun p => T7Gap.pairWeight left right p * f p) (T7Gap.pairOutcomes left right)).sum =
    left.mean fun x => right.mean fun y => f (x, y)
T7Gap.productLaw_mean {X Y : Type} (left : T7Gap.FiniteLaw X) (right : T7Gap.FiniteLaw Y) (f : X × Y → Rat) :
  (T7Gap.productLaw left right).mean f = left.mean fun x => right.mean fun y => f (x, y)
T7Gap.symmetricProduct_symmetric {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) (p q : X × Y) :
  T7Gap.symmetricProductValue W p q = T7Gap.symmetricProductValue W q p
T7Gap.symmetricProduct_nonnegative {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) (p q : X × Y) :
  0 ≤ T7Gap.symmetricProductValue W p q
T7Gap.symmetricProduct_mean {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) :
  (T7Gap.symmetricProductKernel W).mean = W.mean * W.mean
T7Gap.rat_sum_pos.{u_1} {α : Type u_1} (xs : List α) (w : α → Rat) (hn : ∀ (x : α), x ∈ xs → 0 ≤ w x)
  (hp : ∃ x, x ∈ xs ∧ 0 < w x) : 0 < (List.map w xs).sum
T7Gap.beta_positive : 0 < T7Gap.beta
T7Gap.reciprocal_beta_power_positive (n : Nat) : 0 < 1 / T7Gap.beta ^ n
T7Gap.pointMass_nonnegative (p : T7.Point) : 0 ≤ T7Gap.pointRawMass p
T7Gap.faceMass_nonnegative (j : T7.Face) : 0 ≤ T7Gap.faceRawMass j
T7Gap.literal_face_norms : List.ofFn T7Gap.faceNorm = [3, 3, 3, 5, 3, 3, 5, 3, 3, 3]
T7Gap.pairScore_bound (p : T7.Point) (j : T7.Face) : T7Gap.pairScore p j ≤ 446
T7Gap.power_ge_one (x : Rat) (hx : 1 ≤ x) (n : Nat) : 1 ≤ x ^ n
T7Gap.thinning_bounds (p : T7.Point) (j : T7.Face) : 0 < T7Gap.thinning p j ∧ T7Gap.thinning p j ≤ 1
T7Gap.cornerIndex_valid (p : T7.Point) (j : T7.Face) :
  T7.incident p j = true → T7.corner (T7Gap.cornerIndex p j) = (p, j)
T7Gap.pairKernel_nonnegative {X Y : Type} (base : T7Gap.SignedBase X Y) (p : T7.Point) (j : T7.Face) (x : Fin 30 → X)
  (y : Fin 30 → Y) : 0 ≤ T7Gap.pairKernel base p j x y
T7Gap.pairKernel_mean {X Y : Type} (base : T7Gap.SignedBase X Y) (p : T7.Point) (j : T7.Face) :
  ((T7Gap.independentLaw base.left 30).mean fun x =>
      (T7Gap.independentLaw base.right 30).mean (T7Gap.pairKernel base p j x)) =
    1
T7Gap.thinnedPairKernel_nonnegative {X Y : Type} (base : T7Gap.SignedBase X Y) (p : T7.Point) (j : T7.Face)
  (x : Fin 30 → X) (y : Fin 30 → Y) : 0 ≤ T7Gap.thinnedPairKernel base p j x y
T7Gap.thinnedPairKernel_mean {X Y : Type} (base : T7Gap.SignedBase X Y) (p : T7.Point) (j : T7.Face) :
  ((T7Gap.independentLaw base.left 30).mean fun x =>
      (T7Gap.independentLaw base.right 30).mean (T7Gap.thinnedPairKernel base p j x)) =
    1
T7Gap.constructedKernel_mean_one {X Y : Type} (base : T7Gap.SignedBase X Y) : (T7Gap.constructedKernel base).mean = 1
T7Gap.constructed_symmetric_mean_one {X Y : Type} (base : T7Gap.SignedBase X Y) :
  (T7Gap.symmetricProductKernel (T7Gap.constructedKernel base)).mean = 1
T7Gap.boolean_constructed_mean : (T7Gap.constructedKernel T7Gap.booleanSignedBase).mean = 1
T7Gap.boolean_sign_values :
  T7Gap.booleanSignedBase.value false false false = 2 ∧
    T7Gap.booleanSignedBase.value false false true = 0 ∧
      T7Gap.booleanSignedBase.value true false false = 0 ∧ T7Gap.booleanSignedBase.value true false true = 2
T7Gap.independentLaw_succ_mean {α : Type} {n : Nat} (law : T7Gap.FiniteLaw α) (f : (Fin (n + 1) → α) → Rat) :
  (T7Gap.independentLaw law (n + 1)).mean f =
    law.mean fun x => (T7Gap.independentLaw law n).mean fun s => f fun i => Fin.cases x s i
T7Gap.fst_cons.{u_1, u_2} {X : Type u_1} {Y : Type u_2} {n : Nat} (p : X × Y) (s : Fin n → X × Y) :
  (fun i => (Fin.cases p s i).fst) = fun i => Fin.cases p.fst (fun i => (s i).fst) i
T7Gap.snd_cons.{u_1, u_2} {X : Type u_1} {Y : Type u_2} {n : Nat} (p : X × Y) (s : Fin n → X × Y) :
  (fun i => (Fin.cases p s i).snd) = fun i => Fin.cases p.snd (fun i => (s i).snd) i
T7Gap.independent_productLaw {X Y : Type} (left : T7Gap.FiniteLaw X) (right : T7Gap.FiniteLaw Y) (n : Nat)
  (f : (Fin n → X) → (Fin n → Y) → Rat) :
  ((T7Gap.independentLaw (T7Gap.productLaw left right) n).mean fun s => f (fun i => (s i).fst) fun i => (s i).snd) =
    (T7Gap.independentLaw left n).mean fun x => (T7Gap.independentLaw right n).mean (f x)
T7Gap.coordinateProduct_mul {n : Nat} (f g : Fin n → Rat) :
  (T7Gap.coordinateProduct fun i => f i * g i) = T7Gap.coordinateProduct f * T7Gap.coordinateProduct g
T7Gap.separated_four_means {α β γ δ : Type} (A : T7Gap.FiniteLaw α) (B : T7Gap.FiniteLaw β) (C : T7Gap.FiniteLaw γ)
  (D : T7Gap.FiniteLaw δ) (f : α → δ → Rat) (g : β → γ → Rat) :
  (A.mean fun a => B.mean fun b => C.mean fun c => D.mean fun d => f a d * g b c) =
    (A.mean fun a => D.mean (f a)) * B.mean fun b => C.mean (g b)
T7Gap.symmetricProduct_density {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) :
  (T7Gap.symmetricProductKernel W).density = W.density * (T7Gap.transposeKernel W).density
T7Gap.bernoulli_mean (p : Rat) (hp : 0 ≤ p) (h1 : p ≤ 1) (f : Bool → Rat) :
  (T7Gap.bernoulliLaw p hp h1).mean f = p * f true + (1 - p) * f false
T7Gap.pairKernel_eq_expectation {X Y : Type} (base : T7Gap.SignedBase X Y) (p : T7.Point) (j : T7.Face) (x : Fin 30 → X)
  (y : Fin 30 → Y) :
  T7Gap.pairKernel base p j x y = (T7Gap.activationLaw (T7Gap.cornerIndex p j)).mean (T7Gap.pairObservable base p j x y)
T7Gap.thinnedPairKernel_eq_expectation {X Y : Type} (base : T7Gap.SignedBase X Y) (p : T7.Point) (j : T7.Face)
  (x : Fin 30 → X) (y : Fin 30 → Y) :
  T7Gap.thinnedPairKernel base p j x y = (T7Gap.thinnedActivationLaw p j).mean (T7Gap.thinnedObservable base p j x y)
T7Gap.pairMoment_incident (p : T7.Point) (j : T7.Face) (h : T7.incident p j = true) (a b : T7.Mask) :
  T7Gap.pairMoment p j a b = T7Gap.activationMoment (T7Gap.cornerIndex p j) a b
T7Gap.pairMoment_nonincident (p : T7.Point) (j : T7.Face) (h : T7.incident p j = false) (a b : T7.Mask)
  (ha : T7.NonemptyMask a) : T7Gap.pairMoment p j a b = 0
T7Gap.rat_prod_zero (xs : List Rat) (h : 0 ∈ xs) : xs.prod = 0
T7Gap.rat_sum_zero.{u_1} {α : Type u_1} (xs : List α) (f : α → Rat) (h : ∀ (x : α), x ∈ xs → f x = 0) :
  (List.map f xs).sum = 0
T7Gap.generalCoefficient_non_incidence (a : T7.Point → T7.Point) (b : T7.Face → T7.Face)
  (h : ¬T7.IncidenceEndomorphism a b) : T7Gap.generalCoefficient a b = 0
T7Gap.cornerIndex_corner (c : Fin 30) : T7Gap.cornerIndex (T7.corner c).fst (T7.corner c).snd = c
T7Gap.corners_incident (c : Fin 30) : T7.incident (T7.corner c).fst (T7.corner c).snd = true
T7Gap.general_identity : T7Gap.generalCoefficient id id = T7Gap.stochasticCoefficient id
T7Gap.general_reversal :
  T7Gap.generalCoefficient T7.reversePoint T7.reverseFace = T7Gap.stochasticCoefficient T7.reverseCorner
T7Gap.general_signed_orbit :
  T7Gap.generalCoefficient id id + T7Gap.generalCoefficient T7.reversePoint T7.reverseFace = -(1 / 2 ^ 59)
T7Gap.coordinateProduct_const (r : Rat) (n : Nat) : (T7Gap.coordinateProduct fun x => r) = r ^ n
T7Gap.scaleKernel_mean {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) (r : Rat) (hr : 0 ≤ r) :
  (T7Gap.scaleKernel W r hr).mean = r * W.mean
T7Gap.scaleKernel_density {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) (r : Rat) (hr : 0 ≤ r) :
  (T7Gap.scaleKernel W r hr).density = r ^ 30 * W.density
T7Gap.rat_member_le_sum (xs : List Rat) (hn : ∀ (x : Rat), x ∈ xs → 0 ≤ x) (x : Rat) (hx : x ∈ xs) : x ≤ xs.sum
T7Gap.kernelValues_nonnegative {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) (r : Rat) :
  r ∈ T7Gap.kernelValues W → 0 ≤ r
T7Gap.kernelBound_positive {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) : 0 < T7Gap.kernelBound W
T7Gap.kernelBound_covers {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) (x : X) (y : Y) (hx : x ∈ W.left.outcomes)
  (hy : y ∈ W.right.outcomes) : W.value x y ≤ T7Gap.kernelBound W
T7Gap.boundedKernel_unit_interval {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) (x : X) (y : Y)
  (hx : x ∈ W.left.outcomes) (hy : y ∈ W.right.outcomes) :
  0 ≤ (T7Gap.boundedKernel W).value x y ∧ (T7Gap.boundedKernel W).value x y ≤ 1
T7Gap.boundedKernel_mean {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) :
  (T7Gap.boundedKernel W).mean = (T7Gap.kernelBound W)⁻¹ * W.mean
T7Gap.boundedKernel_density {X Y : Type} (W : T7Gap.RationalBipartiteKernel X Y) :
  (T7Gap.boundedKernel W).density = (T7Gap.kernelBound W)⁻¹ ^ 30 * W.density
T7Gap.boundedKernel_symmetric {X : Type} (W : T7Gap.RationalBipartiteKernel X X)
  (h : ∀ (x y : X), W.value x y = W.value y x) (x y : X) :
  (T7Gap.boundedKernel W).value x y = (T7Gap.boundedKernel W).value y x
T7Gap.boundedConstructed_mean_positive {X Y : Type} (base : T7Gap.SignedBase X Y) :
  0 < (T7Gap.boundedConstructedKernel base).mean
T7Gap.thinnedMoment_factor (p : T7.Point) (j : T7.Face) (a b : T7.Mask) (ha : T7.NonemptyMask a) :
  T7Gap.thinnedMoment p j a b = T7Gap.thinning p j * T7Gap.pairMoment p j a b
T7Gap.rat_prod_mul.{u_1} {α : Type u_1} (xs : List α) (f g : α → Rat) :
  (List.map (fun x => f x * g x) xs).prod = (List.map f xs).prod * (List.map g xs).prod
T7Gap.thinnedCoefficient_factor (a : T7.Point → T7.Point) (b : T7.Face → T7.Face) :
  T7Gap.thinnedCoefficient a b =
    (List.map (fun c => T7Gap.thinning (a (T7.corner c).fst) (b (T7.corner c).snd)) (List.finRange 30)).prod *
      T7Gap.generalCoefficient a b
T7Gap.averagedCoefficient_exact :
  T7Gap.averagedCoefficient =
    (List.map
        (fun a =>
          T7Gap.productWeight T7Gap.pointPrior a *
            (List.map
                (fun b =>
                  T7Gap.productWeight T7Gap.facePrior b *
                    ((List.map (fun c => T7Gap.thinning (a (T7.corner c).fst) (b (T7.corner c).snd))
                          (List.finRange 30)).prod *
                      T7Gap.generalCoefficient a b))
                (T7.functions T7Gap.facePrior.outcomes 10)).sum)
        (T7.functions T7Gap.pointPrior.outcomes 7)).sum
T7Weighted.pointLoss_nonneg (p q : T7.Point) : 0 ≤ T7Weighted.pointLoss p q
T7Weighted.pointLoss_zero_iff (p q : T7.Point) : T7Weighted.pointLoss p q = 0 ↔ T7.degree q = T7.degree p
T7Weighted.pointLoss_gap (p q : T7.Point) : T7.degree q ≠ T7.degree p → 37 ≤ T7Weighted.pointLoss p q
T7Weighted.int_sum_nonneg.{u_1} {α : Type u_1} (xs : List α) (f : α → Int) (h : ∀ (x : α), x ∈ xs → 0 ≤ f x) :
  0 ≤ (List.map f xs).sum
T7Weighted.int_sum_le.{u_1} {α : Type u_1} (xs : List α) (f g : α → Int) (h : ∀ (x : α), x ∈ xs → f x ≤ g x) :
  (List.map f xs).sum ≤ (List.map g xs).sum
T7Weighted.int_member_le_sum.{u_1} {α : Type u_1} (xs : List α) (f : α → Int) (h : ∀ (x : α), x ∈ xs → 0 ≤ f x) (x : α)
  (hx : x ∈ xs) : f x ≤ (List.map f xs).sum
T7Weighted.face_length (j : Fin 10) : (T7.face j).length = 3
T7Weighted.face_triple (j : Fin 10) :
  T7.face j = [T7Weighted.faceFirst j, T7Weighted.faceSecond j, T7Weighted.faceThird j]
T7Weighted.three_image_face_bound (p q r : T7.Point) (k : T7.Face) :
  2 * ↑(T7Gap.faceHistogram k (T7.degree p)) + 2 * ↑(T7Gap.faceHistogram k (T7.degree q)) +
        2 * ↑(T7Gap.faceHistogram k (T7.degree r)) -
      ↑(T7Gap.faceNorm k) ≤
    7
