  (mu kernelDensity delta invN : Rat) (hw : ∀ (G : T7.SimpleHost n), G ∈ outcomes → 0 ≤ weight G)
  (hdelta : delta = mu ^ 30 - kernelDensity) (hsize : (136 + 30 * mu ^ 30) * invN < delta)
  (hcollision : T7.expectation outcomes weight T7.SimpleHost.homDensity ≤ kernelDensity + 136 * invN)
  (hmean : T7.expectation outcomes weight T7.SimpleHost.edgeDensity = (1 - invN) * mu)
  (hbernoulli : (1 - 30 * invN) * mu ^ 30 ≤ ((1 - invN) * mu) ^ 30)
  (hjensen :
    T7.expectation outcomes weight T7.SimpleHost.edgeDensity ^ 30 ≤
