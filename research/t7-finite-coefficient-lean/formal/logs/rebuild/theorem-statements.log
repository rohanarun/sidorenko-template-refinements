T7.finite_host_conditional {n : Nat} (hn : 0 < n) (outcomes : List (T7.SimpleHost n)) (weight : T7.SimpleHost n → Rat)
  (mu kernelDensity delta : Rat) (hw : ∀ (G : T7.SimpleHost n), G ∈ outcomes → 0 ≤ weight G)
  (hnorm : (List.map weight outcomes).sum = 1) (hmu : 0 ≤ mu) (hdelta : delta = mu ^ 30 - kernelDensity)
  (hdeltaPos : 0 < delta) (hsize : (136 + 30 * mu ^ 30) / delta < ↑n)
  (hcollision : T7.expectation outcomes weight T7.SimpleHost.homDensity ≤ kernelDensity + 136 * (1 / ↑n))
  (hmean : T7.expectation outcomes weight T7.SimpleHost.edgeDensity = (1 - 1 / ↑n) * mu) :
