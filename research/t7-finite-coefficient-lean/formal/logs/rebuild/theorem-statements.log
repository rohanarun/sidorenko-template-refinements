T7Gap.cubeSum_mul {n : Nat} (r : Rat) (f : T7Gap.Bits n → Rat) :
  (T7Gap.cubeSum n fun s => r * f s) = r * T7Gap.cubeSum n f
T7Gap.cubeSum_succ {n : Nat} (f : T7Gap.Bits (n + 1) → Rat) :
  T7Gap.cubeSum (n + 1) f =
