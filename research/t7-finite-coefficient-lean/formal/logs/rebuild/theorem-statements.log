T7Gap.cubeSum_const (n : Nat) (r : Rat) : (T7Gap.cubeSum n fun x => r) = 2 ^ n * r
T7Gap.char_mul {n : Nat} (a b s : T7Gap.Bits n) : T7Gap.char a s * T7Gap.char b s = T7Gap.char (T7Gap.xorBits a b) s
T7Gap.char_zero {n : Nat} (s : T7Gap.Bits n) : T7Gap.char (T7Gap.zeroBits n) s = 1
T7Gap.char_sign {n : Nat} (a s : T7Gap.Bits n) : T7Gap.char a s = 1 ∨ T7Gap.char a s = -1
T7Gap.IsZero_succ {n : Nat} (a : T7Gap.Bits (n + 1)) : T7Gap.IsZero a ↔ a 0 = false ∧ T7Gap.IsZero fun i => a i.succ
T7Gap.cubeSum_char (n : Nat) (a : T7Gap.Bits n) : T7Gap.cubeSum n (T7Gap.char a) = if T7Gap.IsZero a then 2 ^ n else 0
T7Gap.cubeAvg_char {n : Nat} (a : T7Gap.Bits n) : T7Gap.cubeAvg n (T7Gap.char a) = if T7Gap.IsZero a then 1 else 0
T7Gap.xor_zero_iff {n : Nat} (a b : T7Gap.Bits n) : T7Gap.IsZero (T7Gap.xorBits a b) ↔ T7Gap.BitsEq a b
T7Gap.cubeAvg_const (n : Nat) (r : Rat) : (T7Gap.cubeAvg n fun x => r) = r
T7Gap.rat_sum_div.{u_1} {α : Type u_1} (xs : List α) (f : α → Rat) (den : Rat) :
  (List.map (fun s => f s / den) xs).sum = (List.map f xs).sum / den
